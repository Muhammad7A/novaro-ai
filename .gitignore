# Rahasia — jangan pernah di-commit
.env
*.env
!.env.example
# Kecuali dua berkas env yang WAJIB ada di konteks build deploy Emergent:
!frontend/.env

# Kredensial service-account (Google Vertex AI) — jangan pernah di-commit
credentials/

# Kredensial uji riset (kode validator/demo) — dikelola di luar git.
# Sudah pernah ter-commit di sejarah awal; kode validator harus dirotasi
# owner — sejarah lama tetap berisi, tanpa history rewrite.
memory/test_credentials.md

# Dependensi
node_modules/

# Data pengguna (berisi profil usaha & riwayat chat)
# Isi folder diabaikan, foldernya sendiri tetap ada di repositori.
server/data/*
!server/data/.gitkeep

# Hasil ekspor penelitian — memuat data peserta, termasuk mode anonim.
# Data penelitian tidak pernah masuk repositori kode.
server/export/

# Berkas sistem
.DS_Store
*.log
npm-debug.log*
server/data/kode-akses-peserta.txt
server/data/users-seed.json
.env.*
credentials.json
*.pem
*.key
.credentials
