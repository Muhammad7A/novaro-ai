# Salin file ini menjadi .env, lalu isi nilainya.
# JANGAN commit file .env ke Git — isinya rahasia.

# --- Layanan AI: pilih SALAH SATU jalur ---
#
# Jalur 1 (bawaan) — langsung ke Anthropic.
# Kunci API Anthropic. Ambil di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jalur mana yang dipakai: anthropic | vertex | gemini
# Kosongkan untuk perilaku lama (vertex bila GOOGLE_CLOUD_PROJECT diisi, selain
# itu anthropic). Nilai yang tidak dikenali DITOLAK saat start — saklar yang
# salah ketik dan mundur diam-diam ke bawaan berarti menagih ke penyedia yang
# salah tanpa satu pun tanda.
# NOVA_AI_BACKEND=

# Jalur 2 — lewat Google Cloud Vertex AI.
#
# Begitu GOOGLE_CLOUD_PROJECT diisi, server memakai Vertex dan ANTHROPIC_API_KEY
# tidak dibaca lagi. Tidak ada kunci yang dikirim: kredensial diambil dari
# Application Default Credentials — di laptop lewat
# `gcloud auth application-default login`, di Cloud Run otomatis dari service
# account layanan.
#
# Sebelum jalur ini bisa dipakai, di sisi Google Cloud:
#   1. gcloud services enable aiplatform.googleapis.com
#   2. beri service account peran roles/aiplatform.user
#   3. aktifkan Claude di Vertex AI > Model Garden (manual, di Console)
#
# CLOUD_ML_REGION opsional. Jika kosong, gemini.js dan claude.js sama-sama
# jatuh ke 'us-central1' — BUKAN 'global' (itu bawaan SDK mentah AnthropicVertex
# sebelum kode aplikasi mengisi region). Region yang tidak melayani model yang
# diminta gagal sebagai 404 saat permintaan pertama, bukan saat start.
# Pipeline deploy (cloudbuild.yaml) menyetelnya secara eksplisit.
# GOOGLE_CLOUD_PROJECT=
# CLOUD_ML_REGION=us-central1

# Jalur 3 — Gemini di Vertex AI (NOVA_AI_BACKEND=gemini).
#
# Prasyarat GCP-nya sama persis dengan jalur 2, KECUALI Model Garden: Gemini
# tidak perlu diaktifkan manual.
#
# Kenapa jalur ini ada: model Claude di Vertex dijual sebagai partner model dan
# kredit percobaan Google Cloud TIDAK menanggungnya. Gemini produk Google
# langsung, jadi kredit itu berlaku.
#
# Bawaannya gemini-2.5-flash — dipilih karena murah, dan menjelaskan pembukuan
# sederhana bukan pekerjaan penalaran berat.
# GEMINI_MODEL=gemini-2.5-flash

# Port server (opsional, default 3000)
PORT=3000

# Batas JUMLAH permintaan AI per pengguna per jam (opsional, default 40).
# Ini menjaga ledakan permintaan, bukan tagihan.
RATE_LIMIT_PER_HOUR=40

# Batas waktu aplikasi untuk membaca SATU stream jawaban AI, dalam milidetik
# (opsional, default 60000 = 60 detik). Stream yang putus di tengah atau
# melebihi batas ini GAGAL — tidak ada jawaban setengah yang tersimpan.
# Batas waktu SDK hanya menjaga sambungan; yang ini menjaga lamanya pembacaan.
# Naikkan (mis. 240000) bila penyusunan rekomendasi yang sah sering lebih
# dari satu menit di penyedianya.
# NOVA_AI_STREAM_TIMEOUT_MS=60000

# --- Anggaran token: yang menjaga TAGIHAN ---
# Batas biaya per peserta, dihitung per hari dan per minggu kalender (WIB,
# minggu mulai Senin). Jatah diperiksa SEBELUM permintaan dikirim.
#
# Sebagai gambaran: satu pertanyaan chat ≈ 2.900–4.700 token, satu kali membuat
# rekomendasi ≈ 4.800–6.600 token. Jadi 10.000/hari ≈ 2–3 pertanyaan per hari,
# dan 50.000/minggu ≈ 12–17 pertanyaan per minggu.
#
# Batas mingguan sengaja lebih kecil dari 7 x batas harian: batas harian mencegah
# jatah seminggu habis dalam satu malam, batas mingguan yang menentukan plafonnya.
#
# Token yang dibaca dari cache dihitung 10% sesuai tarifnya, sehingga peserta
# yang bukunya paling panjang tidak dihukum karena awalannya paling besar.
TOKEN_BUDGET_DAILY=60000
TOKEN_BUDGET_WEEKLY=300000

# --- Keamanan (produksi) ---
# Paksa HTTPS. Nyalakan di server produksi; biarkan kosong saat mengembangkan lokal.
FORCE_HTTPS=1

# Alamat resmi aplikasi ini, mis. nova.contohdomain.id
# Dipakai sebagai tujuan pengalihan http:// -> https://. Kalau dikosongkan,
# server memakai header Host dari peramban — dan header itu bisa dipalsukan
# sehingga alamat program bisa dipakai mengalihkan orang ke situs lain.
# Isi ini kalau FORCE_HTTPS=1.
PUBLIC_HOST=

# Nyalakan bila aplikasi berada di belakang Nginx, supaya alamat IP asli terbaca.
# JANGAN nyalakan bila aplikasi terbuka langsung ke internet tanpa proxy.
TRUST_PROXY=1

# Maksimal percobaan kode akses yang gagal per IP dalam 15 menit (default 20).
# Kode yang BENAR selalu diterima walau batas ini tercapai — beberapa peserta
# bisa berbagi satu alamat IP di jaringan seluler, dan mereka tidak boleh saling
# mengunci. Yang dibatasi hanyalah penebakan.
LOGIN_MAX_ATTEMPTS=20

# --- Validasi materi oleh ahli ---
# Kode yang dibagikan kepada VALIDATOR (ahli akuntansi/pembelajaran) agar bisa
# membuka lembar validasi materi di alamat /validasi. Bukan kode peserta:
# validator tidak pernah bisa membuka buku kas siapa pun dengan kode ini.
#
# Selama baris ini kosong, halaman /validasi tetap terbuka tetapi tidak bisa
# memuat instrumen maupun mengirim jawaban — sengaja, supaya tidak ada lembar
# yang bisa dititipkan orang asing ke dalam data penelitian.
#
# Isi dengan kata sandi acak yang panjang, mis. hasil: openssl rand -base64 18
VALIDASI_KODE=

# Kode PENGELOLA — dipegang peneliti sendiri, tidak pernah dibagikan kepada
# validator. Hanya kode ini yang bisa mengunduh seluruh lembar yang sudah masuk
# beserta rekapnya lewat GET /api/validasi/hasil.
#
# Harus BERBEDA dari VALIDASI_KODE. Kalau keduanya diisi sama, rute unduhannya
# menolak melayani sama sekali (503) — karena kode yang sama berarti setiap
# validator bisa membaca penilaian rekannya, dan itu membatalkan alasan lembar
# ini dipisah sejak awal.
#
# Wajib diisi bila server berjalan di mesin yang tidak bisa dimasuki lewat shell
# (Cloud Run). Di sana `npm run validasi` tidak bisa dijalankan, jadi tanpa kode
# ini hasil validasi masuk tetapi tidak bisa diambil kembali oleh siapa pun.
#
# Isi dengan kata sandi acak yang panjang, mis. hasil: openssl rand -base64 18
VALIDASI_PENGELOLA_KODE=

# --- Cadangan ---
# Jumlah salinan yang disimpan (opsional, default 14)
BACKUP_KEEP=14

# --- Produksi: log, zona waktu, penutupan ---
# Bentuk log. Kosong/`teks` = enak dibaca manusia (untuk laptop & journalctl).
# `json` = satu obyek JSON per baris berikut medan `severity`, yang dikenali
# Cloud Logging sehingga peringatan bisa disaring dan dijadikan dasar alert.
LOG_FORMAT=json

# Zona waktu proses. Logika hari sudah memakai WIB secara eksplisit di kode,
# jadi ini hanya membuat cap waktu di log ikut terbaca sebagai waktu setempat.
TZ=Asia/Jakarta

# Berapa lama menunggu permintaan & penulisan yang sedang berjalan selesai saat
# server dimatikan (opsional, default 8000 ms). Harus LEBIH KECIL daripada
# TimeoutStopSec di systemd, supaya aplikasi selalu sempat berhenti sendiri
# sebelum dibunuh paksa di tengah penulisan.
SHUTDOWN_TIMEOUT_MS=8000

# --- Lokasi data ---
# Letak folder data (opsional, default server/data)
# NOVA_DATA_DIR=/var/lib/nova

# --- Penyimpanan eksternal (produksi) ---
# Tiga jalur, satu urutan prioritas — yang pertama terisi yang dipakai:
#
#   1. DATABASE_URL  → PostgreSQL (Cloud SQL / server sendiri)
#   2. MONGO_URI     → MongoDB — penyimpanan terkelola Emergent produksi
#   3. (kosong)      → berkas JSON di NOVA_DATA_DIR (dev, uji, CLI, preview)
#
# Tanpa salah satunya, data hidup di sistem berkas container yang FANA:
# redeploy mengganti container dan seluruh users.json lenyap. Untuk mode
# demo kontes itu disengaja (akun demo menabur ulang sendiri); untuk
# pengguna sungguhan, JANGAN menjalankan tanpa backend persisten.
#
# Nama env Mongo yang dikenali (isi SALAH SATU):
# MONGO_URI=
# MONGODB_URI=
# MONGO_URL=
# MONGODB_URL=
# MONGO_DB=            # opsional — kosong = ikuti nama db di URI

# Setel '1' di lingkungan PRODUKSI (Emergent Deploy → Environment Variables).
# Bila terisi tanpa DATABASE_URL/MONGO_URI, server MENOLAK MENYALA — lebih
# baik gagal terlihat daripada menerima catatan yang pasti lenyap saat
# redeploy. Jangan diisi di dev/test/preview/demo.
# NOVA_REQUIRE_PERSISTENT_STORE=1

# --- Override eksplisit jenis penyimpanan (opsional) ---
# Platform deployment bisa menyuntikkan MONGO_URL/MONGO_URI otomatis. Bila kamu
# TETAP ingin jalur berkas JSON (mis. demo/preview), setel:
# NOVA_STORAGE=json
# Nilai sah: json | mongo | postgres — menang atas semua deteksi otomatis.

# ===============================================================
# --- Enterprise quickstart: magic-link login & interview sidecar ---
# ===============================================================
# The enterprise (US) edition adds two opt-in surfaces on top of the
# access-code login. Everything here is OPTIONAL: with all of these left
# empty the server runs the same feature set as the pilot edition.

# Magic-link sign-in sends a one-time login link (15-minute TTL) to the
# owner's email. MAIL_PROVIDER is intentionally small:
#   (unset)  = dev mode — the link is printed to the server log, never sent
#   test     = in-memory outbox (autentikasi.test.js reads it back)
#   anything else is rejected loudly: real providers are not implemented yet
# MAIL_PROVIDER=

# AI interview sidecar (Groundwork interviewer engine). When the URL is
# empty, every interview route answers 503 fail-closed and the feature
# disappears from the UI — no other behavior changes. The secret is sent
# ONLY to the sidecar (auth header) and is never logged.
# NOVA_INTERVIEW_SIDECAR_URL=
# NOVA_INTERVIEW_SECRET=
# Relay timeout in milliseconds (default 10000).
# NOVA_INTERVIEW_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Self-serve signup (W1 exit gap #1). The HMAC secret gates the whole
# feature: without it, /api/auth/request-signup answers 503 fail-closed and
# /api/auth/methods reports signup:false. Verification links are one-time
# HMAC tokens (prefix su1.) that expire in 15 minutes; consumption is
# single-use by verified-state presence (replay answers 409 duplicate).
# NOVA_SIGNUP_SECRET=
#
# EMAIL DELIVERY IS NOT WIRED YET. With no SMTP configured, the verification
# link NEVER leaves the server unless development mode is on:
#   NOVA_DEV_MODE=1  -> the response body carries `devLink` (obvious and
#                       labeled as such in the UI) so local flows are testable.
#   production       -> neutral "check your email" response; the link is
#                       not exposed anywhere. Wire an SMTP provider before
#                       enabling signup in production.
# NOVA_DEV_MODE=""      # set to 1 only for local development

# ---------------------------------------------------------------------------
# News feed (W1). Comma-separated RSS/Atom URLs. Defaults (US small business
# and finance): Yahoo Finance, CNBC business, SBA headlines, Forbes
# entrepreneurs. The server pulls ONE pooled headline set per 15 minutes for
# ALL users; requests to feeds carry NO user identifiers (zero PII out).
# Set to "-" to disable the feature entirely — /api/news then answers an
# honest {status:'unavailable'} with no fetching at all.
# NOVA_NEWS_FEEDS=
# Pool TTL and per-feed timeout, milliseconds (defaults 900000 / 8000) —
# override is for tests only.
# NOVA_NEWS_TTL_MS=900000
# NOVA_NEWS_TIMEOUT_MS=8000

# For the enterprise profile the recommendation build regularly runs past
# one minute; raise the app-level stream deadline (see the entry above).
# NOVA_AI_STREAM_TIMEOUT_MS=240000
